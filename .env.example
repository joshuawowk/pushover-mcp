# Copy to .env (never commit .env).
PUSHOVER_TOKEN=your-pushover-application-api-token
# Optional default user/group key; tools accept a `user` override per call.
PUSHOVER_USER_KEY=your-pushover-user-or-group-key
# Optional default device name(s), comma-separated.
PUSHOVER_DEVICE=
# HTTP transport only: hosts the DNS-rebinding guard will accept (host:port, comma-separated).
# Add every hostname/IP you reach the server by, e.g. localhost:8735,mybox.lan:8735
PUSHOVER_MCP_ALLOWED_HOSTS=localhost:8735,127.0.0.1:8735
